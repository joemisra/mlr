// Per-hit controls and coefficients are latched in the audio thread.
@state hitPitchHz = 140;
@state hitDecayMs = 450;
@state hitBendHz = 160;
@state hitBendDecayMs = 35;
@state hitFmAmount = 0.5;
@state hitFmRatio = 1.5;
@state hitModeRatio = 1.59;
@state hitModeLevel = 0.25;
@state hitNoiseLevel = 0.08;
@state hitNoiseDecayMs = 12;
@state hitDrive = 1.3;
@state hitLevel = 0.5;
@state active = 0;
@state env = 0;
@state bendEnv = 0;
@state noiseEnv = 0;
@state envCoef = 0;
@state bendCoef = 0;
@state noiseCoef = 0;
@state phase = 0;
@state modePhase = 0;
@state modPhase = 0;
@state noiseState = 12344;
let trig = in1;
let sr = samplerate();
if (trig > 0) {
    hitPitchHz = in2;
    hitDecayMs = in3;
    hitBendHz = in4;
    hitBendDecayMs = in5;
    hitFmAmount = in6;
    hitFmRatio = in7;
    hitModeRatio = in8;
    hitModeLevel = in9;
    hitNoiseLevel = in10;
    hitNoiseDecayMs = in11;
    hitDrive = in12;
    hitLevel = in13;
}
if (trig > 0) {
    active = 1;
    env = 1; bendEnv = 1; noiseEnv = 1;
    phase = 0; modePhase = 0; modPhase = 0;
    envCoef = exp(-6.907755 / (maximum(10, hitDecayMs) * 0.001 * sr));
    bendCoef = exp(-6.907755 / (maximum(1, hitBendDecayMs) * 0.001 * sr));
    noiseCoef = exp(-6.907755 / (maximum(1, hitNoiseDecayMs) * 0.001 * sr));
}
out1 = 0;
if (active > 0) {
env *= envCoef; bendEnv *= bendCoef; noiseEnv *= noiseCoef;
let hz = clamp(hitPitchHz + hitBendHz * bendEnv, 20, sr * 0.2);
modPhase = wrap(modPhase + minimum(hz * hitFmRatio, sr * 0.45) / sr, 0, 1);
phase = wrap(phase + hz / sr, 0, 1);
modePhase = wrap(modePhase + minimum(hz * hitModeRatio, sr * 0.45) / sr, 0, 1);
let membrane = sin(phase * 6.283185307179586 + sin(modPhase * 6.283185307179586) * hitFmAmount * env);
let shell = sin(modePhase * 6.283185307179586) * env * env;
noiseState = wrap((noiseState + 1) * 16807, 0, 2147483647) - 1;
let white = (noiseState + 1) / 1073741823.5 - 1;
let raw = membrane * env * 0.8 + shell * hitModeLevel * 0.6 + white * noiseEnv * hitNoiseLevel * 0.4;
let drive = maximum(0.25, hitDrive);
out1 = tanh(raw * drive) / tanh(drive) * clamp(hitLevel, 0, 1);
if (env < 0.0000001 && noiseEnv < 0.0000001) active = 0;
}
